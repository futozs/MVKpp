{
  "name": "mvk-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MVK MobilON+ backend: auth-injektalo proxy + GTFS-RT dekod + valos erkezesek + token-mentes + auto-renew (Hono + TypeScript).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:ts": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node src/db/migrate.ts",
    "archive:backfill": "node tools/archive-backfill.ts",
    "worker": "node src/worker/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "gtfs-realtime-bindings": "^1.1.1",
    "hono": "^4.9.0",
    "mysql2": "^3.24.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.0"
  }
}
