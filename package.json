{
  "name": "mvk",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "MVK valós idejű buszkövető — Next.js web, realtime worker, macOS token-agent.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "build": "bun run --cwd packages/db generate && bun run --cwd apps/web build",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:generate": "bun run --cwd packages/db generate",
    "import:mysql": "bun run --cwd tools/import-mysql start",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test"
  },
  "engines": {
    "node": ">=22"
  }
}
