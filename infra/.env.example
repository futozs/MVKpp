# Másold infra/.env-be és töltsd ki. Titkok generálása:  openssl rand -hex 32
DOMAIN=mvk.pelda.hu

POSTGRES_USER=mvk
POSTGRES_PASSWORD=
POSTGRES_DB=mvk
# VPS RAM-jához igazítsd (4 GB RAM → 1GB / 3GB)
PG_SHARED_BUFFERS=512MB
PG_CACHE=1536MB

# Az MVK token titkosítása az adatbázisban (ha elveszik, a tárolt tokenek olvashatatlanok)
APP_SECRET=
# Védett üzemeltetési végpontok (/_jwt, /_export, /_ingest, /system/*): X-Admin-Key fejléc
ADMIN_KEY=
# A macOS token-agent és a szerver közös titka (az agent install.sh-jának is ez kell)
AGENT_SECRET=

# Web Push — kulcspár:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:te@pelda.hu

# Gyorsítótár: Upstash Redis kapcsolati szöveg (Upstash konzol → Database → Connect → "Redis" fül).
#   rediss://default:<jelszó>@<név>.upstash.io:6379
# Üresen hagyva minden a folyamat memóriájában cache-el (működik, csak nem közös és nem éli túl az újraindítást).
REDIS_URL=

# ── Rendszer-hub (belső hálós üzemeltetői pult) ─────────────────────────
# A szerver LAN-címe, ahol a hub figyel (pl. 192.168.1.11). Üresen: csak 127.0.0.1.
# SOHA ne 0.0.0.0 egy nyilvános VPS-en.
HUB_BIND=192.168.1.11
HUB_PORT=8099
# Belépési jelszó (min. 12 karakter):  openssl rand -base64 24
HUB_PASSWORD=
# Napi automatikus mentés órája (Budapest), -1 = ki; ennyi napi mentés marad meg
HUB_BACKUP_HOUR=4
HUB_BACKUP_KEEP=7
# Csak ha a repó privát HTTPS-remote: GitHub fine-grained token (Contents: read) a frissítéshez
HUB_GIT_TOKEN=
# Engedett kliens-tartományok (vesszővel). Üresen: magánhálózatok + loopback + VPN (100.64/10).
HUB_ALLOWED_CIDRS=
