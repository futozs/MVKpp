# Másold infra/.env-be és töltsd ki. Titkok generálása:  openssl rand -hex 32
DOMAIN=mvk.pelda.hu

POSTGRES_USER=mvk
POSTGRES_PASSWORD=
POSTGRES_DB=mvk
# VPS RAM-jához igazítsd (4 GB RAM → 1GB / 3GB)
PG_SHARED_BUFFERS=512MB
PG_CACHE=1536MB

# Az MVK token titkosítása az adatbázisban (ha elveszik, a tárolt tokenek olvashatatlanok)
APP_SECRET=
# Védett üzemeltetési végpontok (/_jwt, /_export, /_ingest, /system/*): X-Admin-Key fejléc
ADMIN_KEY=
# A macOS token-agent és a szerver közös titka (az agent install.sh-jának is ez kell)
AGENT_SECRET=

# Web Push — kulcspár:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:te@pelda.hu

# Gyorsítótár: Upstash Redis kapcsolati szöveg (Upstash konzol → Database → Connect → "Redis" fül).
#   rediss://default:<jelszó>@<név>.upstash.io:6379
# Üresen hagyva minden a folyamat memóriájában cache-el (működik, csak nem közös és nem éli túl az újraindítást).
REDIS_URL=
