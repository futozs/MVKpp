# Másold infra/.env-be és töltsd ki. Titkok generálása:  openssl rand -hex 32
DOMAIN=mvk.pelda.hu

POSTGRES_USER=mvk
POSTGRES_PASSWORD=
POSTGRES_DB=mvk
# VPS RAM-jához igazítsd (4 GB RAM → 1GB / 3GB)
PG_SHARED_BUFFERS=512MB
PG_CACHE=1536MB

# Az MVK token titkosítása az adatbázisban (ha elveszik, a tárolt tokenek olvashatatlanok)
APP_SECRET=
# Védett üzemeltetési végpontok (/_jwt, /_export, /_ingest, /system/*): X-Admin-Key fejléc — legalább 32 karakter!
ADMIN_KEY=
# A macOS token-agent és a szerver közös titka (az agent install.sh-jának is ez kell)
AGENT_SECRET=

# Web Push — kulcspár:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:te@pelda.hu

# Gyorsítótár: Upstash Redis kapcsolati szöveg (Upstash konzol → Database → Connect → "Redis" fül).
#   rediss://default:<jelszó>@<név>.upstash.io:6379
# Üresen hagyva minden a folyamat memóriájában cache-el (működik, csak nem közös és nem éli túl az újraindítást).
REDIS_URL=

# MÁV+ (OTP2, token nélkül): a Volán és a vasút a megyében, és az MVK tartaléka (401/403 vagy 60 mp kiesés).
# 0 = ki. REGIONAL=0: csak a tartalék marad, Volán és vasút nélkül. Részletek: docs/MAVPLUSZ_OTP2.md, M. fejezet.
OTP2_ENABLED=1
REGIONAL=1

# ── Rendszer-hub (belső hálós üzemeltetői pult) ─────────────────────────
# A szerver LAN-címe, ahol a hub figyel (pl. 192.168.1.11). Üresen: csak 127.0.0.1.
# SOHA ne 0.0.0.0 egy nyilvános VPS-en.
HUB_BIND=192.168.1.11
HUB_PORT=8099
# Belépési jelszó (min. 12 karakter):  openssl rand -base64 24
HUB_PASSWORD=
# Napi automatikus mentés órája (Budapest), -1 = ki; ennyi napi mentés marad meg
HUB_BACKUP_HOUR=4
HUB_BACKUP_KEEP=7
# Csak ha a repó privát HTTPS-remote: GitHub fine-grained token (Contents: read) a frissítéshez
HUB_GIT_TOKEN=
# A hub csak olvasó kulcsa a web válaszidőihez (a web konténer NEM kapja meg az ADMIN_KEY-t):  openssl rand -hex 32
METRICS_KEY=
# Engedett kliens-tartományok (vesszővel). Üresen: magánhálózatok + loopback + VPN (100.64/10).
# Ajánlott szűkíteni a saját LAN-ra és a WireGuard-alhálóra, pl.:  192.168.1.0/24,10.5.5.0/24
# (Az első belépés után a Telepítés → Műveleti naplóban nézd meg, milyen címmel látszol —
#  ha 172.x, a Docker elfedi a valódi címet, és ezt a szűkítést nem lehet használni.)
HUB_ALLOWED_CIDRS=
# Milyen néven éred el a hubot (vesszővel), ha nem IP-címmel — pl. hub.lan. A DNS-rebinding ellen
# minden más Host fejlécet elutasít. IP-cím és localhost mindig mehet.
HUB_ALLOWED_HOSTS=
